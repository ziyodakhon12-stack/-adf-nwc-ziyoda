{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfziyodacitycycle1"
		},
		"ls_adls_landing_key_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls_landing_key'"
		},
		"ls_onprem_aw_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_onprem_aw'"
		},
		"ls_adls_landing_key_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dlsziyodaland.dfs.core.windows.net/"
		},
		"ls_azsql_dw_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-nwc-dev-ziyoda.database.windows.net"
		},
		"ls_azsql_dw_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "NWC_DW"
		},
		"ls_blob_finance_sasUri": {
			"type": "secureString",
			"metadata": "Secure string for 'sasUri' of 'ls_blob_finance'"
		},
		"ls_keyvault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-ziyoda-adf.vault.azure.net/"
		},
		"ls_onprem_aw_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ZIYODA\\SQLEXPRESS"
		},
		"ls_onprem_aw_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorks2022"
		},
		"ls_onprem_aw_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adf_reader"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfziyodacitycycle1_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_landing_key_accountKey": {
						"value": "[parameters('ls_adls_landing_key_accountKey')]"
					},
					"ls_onprem_aw_password": {
						"value": "[parameters('ls_onprem_aw_password')]"
					},
					"ls_azsql_dw_properties_typeProperties_server": {
						"value": "[parameters('ls_azsql_dw_properties_typeProperties_server')]"
					},
					"ls_azsql_dw_properties_typeProperties_database": {
						"value": "[parameters('ls_azsql_dw_properties_typeProperties_database')]"
					},
					"ls_keyvault_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_keyvault_properties_typeProperties_baseUrl')]"
					},
					"ls_adls_landing_key_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_landing_key_properties_typeProperties_url')]"
					},
					"ls_blob_finance_sasUri": {
						"value": "[parameters('ls_blob_finance_sasUri')]"
					},
					"ls_onprem_aw_properties_typeProperties_server": {
						"value": "[parameters('ls_onprem_aw_properties_typeProperties_server')]"
					},
					"ls_onprem_aw_properties_typeProperties_database": {
						"value": "[parameters('ls_onprem_aw_properties_typeProperties_database')]"
					},
					"ls_onprem_aw_properties_typeProperties_userName": {
						"value": "[parameters('ls_onprem_aw_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}